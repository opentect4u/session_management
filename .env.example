PORT=3001
NODE_ENV=development
TRUST_PROXY=0

# Postgres
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
PG_SSL=false

# Password transport encryption (RSA private key, PEM with \n for newlines). Required in production.
# Generate: openssl genrsa 2048   (then replace real newlines with \n)
AUTH_RSA_PRIVATE_KEY=

# Optional overrides - the defaults live in config/index.js
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_IDLE_TIMEOUT_MIN=20
# AUTH_ABSOLUTE_TIMEOUT_HOURS=8
# AUTH_SINGLE_SESSION_POLICY=replace
